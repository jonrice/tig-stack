DOCKER_INFLUXDB_INIT_MODE=setup

## Environment variables used during the setup and operation of the stack
#

# Primary InfluxDB admin/superuser credentials
#
DOCKER_INFLUXDB_INIT_USERNAME=changeme
DOCKER_INFLUXDB_INIT_PASSWORD=changeme 
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=changeme 

# Primary InfluxDB organization & bucket definitions
# 
DOCKER_INFLUXDB_INIT_ORG=changeme 
DOCKER_INFLUXDB_INIT_BUCKET=changeme 

# Primary InfluxDB bucket retention period
#
# NOTE: Valid units are nanoseconds (ns), microseconds(us), milliseconds (ms)
# seconds (s), minutes (m), hours (h), days (d), and weeks (w).
DOCKER_INFLUXDB_INIT_RETENTION=4d 


# InfluxDB port & hostname definitions
#
DOCKER_INFLUXDB_INIT_PORT=8086 
DOCKER_INFLUXDB_INIT_HOST=influxdb 

# Telegraf configuration file
# 
# Will be mounted to container and used as telegraf configuration
TELEGRAF_CFG_PATH=./telegraf/telegraf.conf

# Grafana port definition
GRAFANA_PORT=3000

# -----------------------------------------------------------------------
# iOS Push Notifications (APNs) – notifications service
# -----------------------------------------------------------------------
#
# Obtain APNS_KEY_ID, APNS_TEAM_ID, and the .p8 private key from:
#   https://developer.apple.com/account/resources/authkeys/list
#

# 10-character Key ID shown in the Apple Developer portal
APNS_KEY_ID=changeme

# 10-character Apple Developer Team ID
APNS_TEAM_ID=changeme

# App bundle identifier (e.g. com.example.myapp)
APNS_BUNDLE_ID=changeme

# Full contents of the .p8 private key file, including header and footer lines
APNS_PRIVATE_KEY=changeme

# Comma-separated list of APNs device tokens to notify
APNS_DEVICE_TOKENS=changeme

# Set to "false" to target the production APNs endpoint; defaults to "true" (sandbox)
APNS_SANDBOX=true

# Port that the webhook service will listen on (host-side)
WEBHOOK_PORT=8080
